# ==========================================================
# Algorisys Conference Hall Booking - Environment Configuration
# Copy this file to ".env" and fill in real values.
# NEVER commit the real ".env" file to version control.
# ==========================================================

# Port the server listens on
PORT=3000

# Node environment: development | production
NODE_ENV=development

# Session secret - use a long random string in production
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change_this_to_a_long_random_string

# ----------------------------------------------------------
# SMTP configuration (used to send OTP verification emails)
# ----------------------------------------------------------
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM="Algorisys Conference Booking <no-reply@algorisys.com>"
